<view class="page">

  <view class="header">
    <view class="header-left">
      <text class="header-title">我家的冰箱</text>
      <text class="header-summary">{{totalCount}}种食材 · {{expiringCount}}种快过期</text>
    </view>
    <view class="header-add" bindtap="openAddSheet">
      <text class="header-add-icon">＋</text>
      <text class="header-add-text">添加食材</text>
    </view>
  </view>

  <view class="tab-switch">
    <view class="tab-item {{activeTab === 'inventory' ? 'tab-active' : ''}}" data-tab="inventory" bindtap="switchTab">
      <text>冰箱库存</text>
    </view>
    <view class="tab-item {{activeTab === 'pantry' ? 'tab-active' : ''}}" data-tab="pantry" bindtap="switchTab">
      <text>常备食材</text>
    </view>
  </view>

  <!-- ==================== 冰箱库存视图 ==================== -->
  <block wx:if="{{activeTab === 'inventory'}}">

    <view wx:if="{{loading}}" class="state-loading">
      <text class="state-icon">⏳</text>
      <text class="state-text">加载冰箱...</text>
    </view>
    <view wx:elif="{{error}}" class="state-error">
      <text class="state-icon">⚠️</text>
      <text class="state-text">{{error}}</text>
      <view class="state-retry" bindtap="retryLoad"><text>重新加载</text></view>
    </view>
    <block wx:else>

    <view class="expiring-bar" wx:if="{{expiringItems.length > 0}}">
      <view class="expiring-left">
        <text class="expiring-icon">⚠️</text>
        <text class="expiring-title">{{expiringCount}}样食材快到期</text>
      </view>
      <view class="expiring-items">
        <text wx:for="{{expiringItems}}" wx:key="id" class="expiring-chip">
          {{item.name}} {{item.expiry_label}}
        </text>
      </view>
      <view class="expiring-action" bindtap="prioritizeExpiring">
        <text>优先做掉 ›</text>
      </view>
    </view>

    <view class="search-row">
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索冰箱里的食材" placeholder-class="search-ph" value="{{searchKeyword}}" bindinput="onSearchInput" />
      </view>
    </view>

    <scroll-view class="cat-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="cat-chip {{currentCategory === item ? 'cat-chip-active' : ''}}"
        data-category="{{item}}"
        bindtap="selectCategory"
      >{{item}}</view>
    </scroll-view>

    <view class="inventory-list">
      <view wx:if="{{inventoryItems.length === 0 && !searchKeyword}}" class="empty-state">
        <text class="empty-icon">🧊</text>
        <text class="empty-text">冰箱还是空的</text>
        <text class="empty-hint">添加第一样食材</text>
      </view>
      <view wx:elif="{{filteredItems.length === 0}}" class="empty-state">
        <text class="empty-icon">🔍</text>
        <text class="empty-text">没有找到匹配的食材</text>
      </view>
      <view
        wx:for="{{filteredItems}}"
        wx:key="id"
        class="inv-row"
        data-id="{{item.id}}"
        bindtap="openEditSheet"
      >
        <view class="inv-thumb">
          <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="inv-img"></image>
          <view wx:else class="inv-ph">
            <text class="inv-ph-text">{{item.name[0]}}</text>
          </view>
        </view>
        <view class="inv-info">
          <text class="inv-name">{{item.name}}</text>
          <text class="inv-meta">{{item.quantity_label}} · {{item.storage_label}}</text>
        </view>
        <view class="inv-status status-{{item.freshness_status}}">
          <text class="inv-status-dot"></text>
          <text class="inv-status-text">{{item.expiry_label}}</text>
        </view>
        <view class="inv-more" catchtap="openEditSheet" data-id="{{item.id}}">⋯</view>
      </view>
    </view>

    <view class="cook-bar">
      <view class="cook-bar-left">
        <text class="cook-bar-icon">🥘</text>
        <text class="cook-bar-text">现有食材可以先利用起来</text>
      </view>
      <view class="cook-bar-btn" bindtap="cookWithFridge">看冰箱做菜</view>
    </view>

    </block>
  </block>

  <!-- ==================== 常备食材视图 ==================== -->
  <block wx:if="{{activeTab === 'pantry'}}">

    <view wx:if="{{pantryLoading}}" class="state-loading">
      <text class="state-icon">⏳</text>
      <text class="state-text">加载常备食材...</text>
    </view>
    <view wx:elif="{{pantryError}}" class="state-error">
      <text class="state-icon">⚠️</text>
      <text class="state-text">{{pantryError}}</text>
      <view class="state-retry" bindtap="retryPantry"><text>重新加载</text></view>
    </view>
    <block wx:else>

    <view class="pantry-desc">
      <text>这些食材默认认为家里通常会有，以后生成购物清单时会作为常备项参考。</text>
    </view>

    <view wx:if="{{pantryStaples.length === 0}}" class="empty-state">
      <text class="empty-icon">📦</text>
      <text class="empty-text">还没有常备食材</text>
    </view>

    <view class="pantry-list">
      <view wx:for="{{pantryStaples}}" wx:key="ingredient_id" class="pantry-row">
        <view class="pantry-info">
          <text class="pantry-name">{{item.name}}</text>
          <text wx:if="{{item.assume_available}}" class="pantry-badge">家中常备 ✓</text>
        </view>
        <view class="pantry-more" catchtap="removeStaple" data-ingredient-id="{{item.ingredient_id}}">移除</view>
      </view>
    </view>

    <view class="pantry-add" bindtap="openAddStapleSheet">
      <text class="pantry-add-icon">＋</text>
      <text class="pantry-add-text">添加常备食材</text>
    </view>

    </block>
  </block>

  <!-- ===== 添加食材 bottom sheet ===== -->
  <view wx:if="{{showAddSheet}}" class="sheet-mask" data-surface-id="FRIDGE-OVERLAY-01" bindtap="closeAddSheet">
    <view class="sheet-panel" data-surface-id="FRIDGE-OVERLAY-01" catchtap="noop">
      <view class="sheet-handle"></view>
      <text class="sheet-title">添加食材</text>

      <view class="form-item">
        <text class="form-label">食材名称</text>
        <input class="form-input" placeholder="如：西红柿" data-field="name" bindinput="onAddInput" value="{{addForm.name}}" />
      </view>

      <view class="form-row">
        <view class="form-item form-half">
          <text class="form-label">数量</text>
          <input class="form-input" placeholder="500" type="digit" data-field="quantity" bindinput="onAddInput" value="{{addForm.quantity}}" />
        </view>
        <view class="form-item form-half">
          <text class="form-label">单位</text>
          <picker class="form-picker" range="{{unitOptions}}" bindchange="onAddUnitChange">
            <view class="picker-text">{{addForm.unit_code}} ▾</view>
          </picker>
        </view>
      </view>

      <view wx:if="{{addForm.unit_code === '自定义'}}" class="form-item">
        <text class="form-label">自定义单位</text>
        <input class="form-input" placeholder="如：盒、袋、瓶" data-field="custom_unit" bindinput="onAddInput" value="{{addForm.custom_unit}}" />
      </view>

      <view class="form-item">
        <text class="form-label">存放位置</text>
        <picker class="form-picker" range="{{storageOptions}}" bindchange="onAddStorageChange">
          <view class="picker-text">{{addForm.storage_location}} ▾</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">到期日期</text>
        <picker class="form-picker" mode="date" bindchange="onAddExpiryChange" value="{{addForm.expiry_date}}">
          <view class="picker-text">{{addForm.expiry_date || '选择日期'}} ▾</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="可选" data-field="note" bindinput="onAddInput" value="{{addForm.note}}" />
      </view>

      <view class="sheet-actions">
        <view class="sheet-btn sheet-btn-cancel" bindtap="closeAddSheet">取消</view>
        <view class="sheet-btn sheet-btn-confirm" bindtap="saveAddItem">保存</view>
      </view>
    </view>
  </view>

  <!-- ===== 编辑食材 bottom sheet ===== -->
  <view wx:if="{{showEditSheet}}" class="sheet-mask" data-surface-id="FRIDGE-OVERLAY-02" bindtap="closeEditSheet">
    <view class="sheet-panel" data-surface-id="FRIDGE-OVERLAY-02" catchtap="noop">
      <view class="sheet-handle"></view>
      <text class="sheet-title">编辑 {{editingItem.name}}</text>

      <view class="form-row">
        <view class="form-item form-half">
          <text class="form-label">数量</text>
          <input class="form-input" type="digit" data-field="quantity" bindinput="onEditInput" value="{{editForm.quantity}}" />
        </view>
        <view class="form-item form-half">
          <text class="form-label">单位</text>
          <picker class="form-picker" range="{{unitOptions}}" bindchange="onEditUnitChange">
            <view class="picker-text">{{editForm.unit_code}} ▾</view>
          </picker>
        </view>
      </view>

      <view wx:if="{{editForm.unit_code === '自定义'}}" class="form-item">
        <text class="form-label">自定义单位</text>
        <input class="form-input" placeholder="如：盒、袋、瓶" data-field="custom_unit" bindinput="onEditInput" value="{{editForm.custom_unit}}" />
      </view>

      <view class="form-item">
        <text class="form-label">存放位置</text>
        <picker class="form-picker" range="{{storageOptions}}" bindchange="onEditStorageChange">
          <view class="picker-text">{{editForm.storage_location}} ▾</view>
        </picker>
      </view>

      <view class="form-row">
        <view class="form-item form-half">
          <text class="form-label">购买日期</text>
          <picker class="form-picker" mode="date" bindchange="onEditPurchaseChange" value="{{editForm.purchase_date}}">
            <view class="picker-text">{{editForm.purchase_date || '选择日期'}} ▾</view>
          </picker>
        </view>
        <view class="form-item form-half">
          <text class="form-label">到期日期</text>
          <picker class="form-picker" mode="date" bindchange="onEditExpiryChange" value="{{editForm.expiry_date}}">
            <view class="picker-text">{{editForm.expiry_date || '选择日期'}} ▾</view>
          </picker>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="可选" data-field="note" bindinput="onEditInput" value="{{editForm.note}}" />
      </view>

      <view class="sheet-actions">
        <view class="sheet-btn sheet-btn-danger" bindtap="deleteItem" data-id="{{editingItem.id}}">移出冰箱</view>
        <view class="sheet-btn sheet-btn-confirm" bindtap="saveEditItem">保存</view>
      </view>
    </view>
  </view>

  <!-- ===== 添加常备食材 bottom sheet ===== -->
  <view wx:if="{{showAddStapleSheet}}" class="sheet-mask" data-surface-id="FRIDGE-OVERLAY-03" bindtap="closeAddStapleSheet">
    <view class="sheet-panel sheet-panel-sm" data-surface-id="FRIDGE-OVERLAY-03" catchtap="noop">
      <view class="sheet-handle"></view>
      <text class="sheet-title">添加常备食材</text>
      <view class="form-item">
        <text class="form-label">食材名称</text>
        <input class="form-input" placeholder="如：花椒" bindinput="onStapleNameInput" value="{{newStapleName}}" />
      </view>
      <view class="sheet-actions">
        <view class="sheet-btn sheet-btn-cancel" bindtap="closeAddStapleSheet">取消</view>
        <view class="sheet-btn sheet-btn-confirm" bindtap="saveAddStaple">保存</view>
      </view>
    </view>
  </view>

</view>
