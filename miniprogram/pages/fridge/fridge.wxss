.page {
  padding: 24rpx 32rpx;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(92, 74, 58, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #3E2723;
}

.stat-warn { color: #FF9800; }
.stat-green { color: #7CB342; }

.stat-label {
  font-size: 24rpx;
  color: #8D6E63;
  margin-top: 8rpx;
}

/* 分类标签 */
.cat-tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.cat-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #8D6E63;
  margin-right: 16rpx;
}

.cat-tab-active {
  background: #7CB342;
  color: #FFFFFF;
}

.cat-tab-special {
  background: #FFF3E0;
  color: #FF9800;
}

/* 食材列表 */
.item-list {
  margin-bottom: 32rpx;
}

.item-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(92, 74, 58, 0.04);
}

.item-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAFAFA;
  border-radius: 16rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #3E2723;
  display: block;
}

.item-amount {
  font-size: 24rpx;
  color: #8D6E63;
  margin-top: 4rpx;
  display: block;
}

.item-badge {
  background: #FFF3E0;
  color: #FF9800;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.item-expiry {
  font-size: 22rpx;
  color: #BDBDBD;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #BDBDBD;
}

/* 添加按钮 */
.add-btn {
  position: fixed;
  right: 48rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7CB342, #8BC34A);
  color: #FFFFFF;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(124, 179, 66, 0.4);
  z-index: 50;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-panel {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
  text-align: center;
  margin-bottom: 32rpx;
  display: block;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item-half {
  flex: 1;
}

.form-row {
  display: flex;
  gap: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #8D6E63;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.form-picker {
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.form-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.form-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.form-btn-cancel {
  background: #F5F5F5;
  color: #8D6E63;
}

.form-btn-confirm {
  background: linear-gradient(135deg, #7CB342, #8BC34A);
  color: #FFFFFF;
}
