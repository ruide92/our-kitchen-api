<view class="page">
  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-page">加载中...</view>

  <!-- Error -->
  <view wx:elif="{{loadError}}" class="loading-page">
    <text class="empty-icon">⚠️</text>
    <text class="empty-title">加载失败</text>
    <text class="empty-sub">{{loadError}}</text>
    <view class="empty-btn" bindtap="retryLoad">重新加载</view>
  </view>

  <!-- Recipe content -->
  <view wx:elif="{{recipe}}" class="recipe-content">
    <!-- Hero -->
    <view class="dish-hero">
      <image wx:if="{{recipe.cover_image_url}}" class="hero-img" src="{{recipe.cover_image_url}}" mode="aspectFill"></image>
      <view wx:else class="hero-img hero-placeholder">🍽</view>
      <view class="hero-overlay"></view>
    </view>

    <!-- Info card -->
    <view class="dish-info-card">
      <view class="dish-title-row">
        <text class="dish-name">{{recipe.name}}</text>
      </view>
      <view class="dish-desc">{{recipe.description || '暂无描述'}}</view>
      <view class="dish-tags">
        <text wx:if="{{recipe.category_code}}" class="tag tag-green">{{recipe.category_code}}</text>
        <text wx:for="{{mealTypes}}" wx:key="*this" class="tag tag-blue">{{item}}</text>
        <text wx:for="{{tags}}" wx:key="*this" class="tag tag-gray">{{item}}</text>
      </view>
      <view class="dish-stats">
        <view class="stat-item">
          <text class="stat-icon">⏱</text>
          <text class="stat-value">{{recipe.cook_time_minutes || 20}}分钟</text>
        </view>
        <view class="stat-item">
          <text class="stat-icon">📊</text>
          <text class="stat-value">{{recipe.difficulty ? (recipe.difficulty + '级') : '普通'}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-icon">👥</text>
          <text class="stat-value">{{recipe.base_servings || 2}}人份</text>
        </view>
        <view class="stat-item" wx:if="{{recipe.spiciness > 0}}">
          <text class="stat-icon">🌶</text>
          <text class="stat-value">辣度{{recipe.spiciness}}/5</text>
        </view>
      </view>
      <view class="cookware-row" wx:if="{{cookware.length > 0}}">
        <text class="cookware-label">厨具：</text>
        <text wx:for="{{cookware}}" wx:key="*this" class="cookware-tag">{{item}}</text>
      </view>
      <view class="allergens-row" wx:if="{{allergens.length > 0}}">
        <text class="allergens-label">过敏原：</text>
        <text wx:for="{{allergens}}" wx:key="*this" class="allergen-tag">{{item}}</text>
      </view>
    </view>

    <!-- Tab bar -->
    <view class="tab-bar">
      <view class="tab-item {{currentTab === 'ingredients' ? 'tab-active' : ''}}" data-tab="ingredients" bindtap="switchTab">食材</view>
      <view class="tab-item {{currentTab === 'steps' ? 'tab-active' : ''}}" data-tab="steps" bindtap="switchTab">做法</view>
      <view class="tab-item {{currentTab === 'nutrition' ? 'tab-active' : ''}}" data-tab="nutrition" bindtap="switchTab">营养</view>
    </view>

    <!-- Tab content -->
    <view class="tab-content">
      <!-- Ingredients -->
      <view wx:if="{{currentTab === 'ingredients'}}" class="ingredients-section">
        <view class="ingredient-group" wx:if="{{ingredients.length > 0}}">
          <view wx:for="{{ingredients}}" wx:key="id" class="ingredient-item">
            <text class="ing-name">{{item.displayName}}</text>
            <text class="ing-amount">{{item.amountText}}</text>
            <text wx:if="{{item.type}}" class="ing-type">{{item.type}}</text>
          </view>
        </view>
        <view wx:else class="empty-tip">暂无食材信息</view>
      </view>

      <!-- Steps -->
      <view wx:if="{{currentTab === 'steps'}}" class="steps-section">
        <view wx:for="{{steps}}" wx:key="id" class="step-item">
          <view class="step-num">{{item.stepNo || (index + 1)}}</view>
          <view class="step-content">
            <text wx:if="{{item.title}}" class="step-title">{{item.title}}</text>
            <text class="step-text">{{item.instruction}}</text>
            <text wx:if="{{item.durationText}}" class="step-time">⏱ {{item.durationText}}</text>
            <text wx:if="{{item.tip}}" class="step-tip">💡 {{item.tip}}</text>
          </view>
        </view>
        <view wx:if="{{steps.length === 0}}" class="empty-tip">暂无做法步骤</view>
      </view>

      <!-- Nutrition -->
      <view wx:if="{{currentTab === 'nutrition'}}" class="nutrition-section">
        <view wx:if="{{nutrition}}" class="nutrition-detail">
          <text wx:for="{{nutrition}}" wx:key="*this" class="nutrition-line">{{item}}</text>
        </view>
        <view wx:else class="empty-tip">暂无营养信息</view>
      </view>
    </view>

    <!-- Bottom actions -->
    <view class="bottom-actions safe-bottom">
      <view class="action-btn {{isFavorite ? 'action-favorited' : 'action-secondary'}} {{favoriteBusy ? 'btn-busy' : ''}}" bindtap="onToggleFavorite">
        <text class="action-icon">{{isFavorite ? '❤️' : '🤍'}}</text>
        <text class="action-text">{{isFavorite ? '已收藏' : '收藏'}}</text>
      </view>
      <view class="action-btn action-secondary {{ratingBusy ? 'btn-busy' : ''}}" bindtap="onOpenRating">
        <text class="action-icon">⭐</text>
        <text class="action-text">{{currentRating > 0 ? currentRating + '星' : '评分'}}</text>
      </view>
      <view class="action-btn action-secondary {{busy ? 'btn-busy' : ''}}" bindtap="addToMeal">
        <text class="action-icon">📋</text>
        <text class="action-text">加入本餐</text>
      </view>
      <view class="action-btn action-primary {{busy ? 'btn-busy' : ''}}" bindtap="startCooking">
        <text class="action-icon">👨‍🍳</text>
        <text class="action-text">开始做饭</text>
      </view>
    </view>

    <!-- Rating panel -->
    <view wx:if="{{showRatingPanel}}" class="sheet-mask-no-tabbar" data-surface-id="DETAIL-OVERLAY-01" bindtap="onCloseRating">
      <view class="sheet-panel-no-tabbar rating-panel" data-surface-id="DETAIL-OVERLAY-01" catchtap="">
        <view class="rating-title">给这道菜评分</view>
        <view class="rating-stars">
          <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
            class="rating-star {{item <= currentRating ? 'star-active' : ''}}"
            data-rating="{{item}}" bindtap="onSetRating">
            {{item <= currentRating ? '★' : '☆'}}
          </view>
        </view>
        <view class="rating-hint">点击星级完成评分</view>
        <view wx:if="{{currentRating > 0}}" class="rating-delete" bindtap="onDeleteRating">取消评分</view>
        <view class="rating-close" bindtap="onCloseRating">关闭</view>
      </view>
    </view>
  </view>

  <!-- No recipe (should not happen with error handling, but safe fallback) -->
  <view wx:else class="loading-page">菜谱不存在</view>
</view>
