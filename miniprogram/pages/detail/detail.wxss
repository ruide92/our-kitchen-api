.page {
  min-height: 100vh;
  background: #FFF9F0;
  padding-bottom: 140rpx;
}

.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: #BDBDBD;
}

/* 顶部大图 */
.dish-hero {
  position: relative;
  width: 100%;
  height: 520rpx;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, transparent 40%, transparent 60%, rgba(0,0,0,0.3) 100%);
}

.hero-actions {
  position: absolute;
  top: 60rpx;
  right: 32rpx;
  display: flex;
  gap: 16rpx;
}

.hero-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

/* 菜品信息卡片 */
.dish-info-card {
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  margin-top: -40rpx;
  position: relative;
  padding: 32rpx;
  box-shadow: 0 -4rpx 24rpx rgba(92, 74, 58, 0.08);
}

.dish-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.dish-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #3E2723;
  flex: 1;
}

.kiss-badge {
  background: #FCE4EC;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.dish-desc {
  font-size: 26rpx;
  color: #8D6E63;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.dish-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-green { background: #E8F5E9; color: #7CB342; }
.tag-orange { background: #FFF3E0; color: #FF9800; }
.tag-gray { background: #F5F5F5; color: #9E9E9E; }
.tag-pink { background: #FCE4EC; color: #E91E63; }

.dish-stats {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid #F0EBE5;
  border-bottom: 2rpx solid #F0EBE5;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
  margin-bottom: 8rpx;
}

.stat-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.stat-value {
  font-size: 24rpx;
  color: #5D4037;
}

.health-row, .rating-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.health-label, .rating-label {
  font-size: 26rpx;
  color: #8D6E63;
  width: 140rpx;
}

.health-stars {
  color: #FF9800;
  font-size: 28rpx;
  margin-right: 12rpx;
}

.health-score {
  font-size: 24rpx;
  color: #BDBDBD;
}

.rating-stars {
  display: flex;
  margin-right: 12rpx;
}

.rating-star {
  font-size: 36rpx;
  color: #E0E0E0;
  margin-right: 4rpx;
}

.star-active {
  color: #FF9800;
}

.rating-hint {
  font-size: 22rpx;
  color: #BDBDBD;
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  padding: 0 32rpx;
  border-bottom: 2rpx solid #F0EBE5;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8D6E63;
  position: relative;
}

.tab-active {
  color: #7CB342;
  font-weight: bold;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #7CB342;
  border-radius: 3rpx;
}

/* Tab内容 */
.tab-content {
  background: #FFFFFF;
  padding: 32rpx;
  min-height: 400rpx;
}

/* 食材 */
.ingredient-group {
  margin-bottom: 32rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #3E2723;
  margin-bottom: 16rpx;
  display: block;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #FAFAFA;
}

.ing-name {
  font-size: 26rpx;
  color: #5D4037;
}

.ing-amount {
  font-size: 26rpx;
  color: #8D6E63;
}

/* 做法 */
.step-item {
  display: flex;
  margin-bottom: 28rpx;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #7CB342;
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.step-content {
  flex: 1;
}

.step-text {
  font-size: 28rpx;
  color: #3E2723;
  line-height: 1.6;
  display: block;
}

.step-time {
  font-size: 24rpx;
  color: #FF9800;
  margin-top: 8rpx;
  display: block;
}

/* 小贴士 */
.tip-item {
  display: flex;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #FFF8E1;
  border-radius: 16rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: #5D4037;
  line-height: 1.5;
}

/* 营养 */
.nutrition-item {
  margin-bottom: 20rpx;
}

.nutrition-label {
  font-size: 26rpx;
  color: #8D6E63;
  display: block;
  margin-bottom: 8rpx;
}

.nutrition-value {
  font-size: 28rpx;
  color: #3E2723;
  line-height: 1.5;
}

.nutrition-tags {
  display: flex;
  flex-wrap: wrap;
}

.nut-tag {
  background: #E8F5E9;
  color: #7CB342;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.empty-tip {
  text-align: center;
  color: #BDBDBD;
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 8rpx;
}

.action-secondary {
  background: #F5F5F5;
  color: #5D4037;
}

.action-primary {
  background: linear-gradient(135deg, #7CB342, #8BC34A);
  color: #FFFFFF;
}

.action-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 评分弹窗 */
.rating-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.rating-panel {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rating-panel-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
  margin-bottom: 32rpx;
}

.rating-panel-stars {
  display: flex;
  margin-bottom: 24rpx;
}

.panel-star {
  font-size: 72rpx;
  color: #E0E0E0;
  margin: 0 8rpx;
}

.rating-panel-hint {
  font-size: 24rpx;
  color: #BDBDBD;
  text-align: center;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
