.page { padding: 24rpx 32rpx; min-height: 100vh; padding-bottom: 60rpx; }
.header { margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #3E2723; }

/* 空状态 */
.empty-state { padding: 120rpx 48rpx; text-align: center; }
.empty-icon { font-size: 100rpx; display: block; margin-bottom: 24rpx; }
.empty-text { font-size: 32rpx; font-weight: bold; color: #3E2723; display: block; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #8D6E63; }

/* 厨房引导 */
.kitchen-guide { background: #fff; border-radius: 24rpx; padding: 64rpx 32rpx; margin-top: 24rpx; text-align: center; }
.guide-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.guide-title { font-size: 32rpx; font-weight: bold; color: #3E2723; margin-bottom: 16rpx; }
.guide-desc { font-size: 26rpx; color: #8D6E63; line-height: 1.6; margin-bottom: 48rpx; }
.guide-actions { display: flex; flex-direction: column; gap: 24rpx; }
.guide-btn { height: 88rpx; border-radius: 44rpx; font-size: 28rpx; line-height: 88rpx; }
.guide-btn::after { border: none; }
.guide-btn.primary { background: linear-gradient(135deg, #7CB342, #8BC34A); color: #fff; }
.guide-btn.secondary { background: #FFF3E0; color: #FF9800; }

/* 厨房卡片 */
.kitchen-card { display: flex; align-items: center; background: linear-gradient(135deg, #FFF9F0, #FFECB3); border-radius: 24rpx; padding: 32rpx; margin-bottom: 32rpx; }
.kitchen-icon { font-size: 60rpx; margin-right: 24rpx; }
.kitchen-info { flex: 1; }
.kitchen-name { font-size: 32rpx; font-weight: bold; color: #3E2723; display: block; }
.kitchen-desc { font-size: 24rpx; color: #8D6E63; margin-top: 4rpx; display: block; }
.edit-icon { font-size: 32rpx; color: #BDBDBD; }

/* 成员列表 */
.section-title { font-size: 28rpx; font-weight: bold; color: #3E2723; margin-bottom: 16rpx; }
.member-list { background: #fff; border-radius: 20rpx; padding: 8rpx 24rpx; margin-bottom: 32rpx; }
.member-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid #FAFAFA; }
.member-item:last-child { border-bottom: none; }
.member-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; margin-right: 20rpx; background: #F5F5F5; display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.member-avatar.placeholder { background: #F5F5F5; }
.member-info { flex: 1; }
.member-name { font-size: 28rpx; font-weight: 500; color: #3E2723; display: block; }
.member-role { font-size: 22rpx; color: #7CB342; margin-top: 4rpx; display: block; }
.empty-members { padding: 32rpx 0; text-align: center; font-size: 26rpx; color: #BDBDBD; }

/* 邀请区域 */
.invite-section { background: #fff; border-radius: 20rpx; padding: 32rpx 24rpx; margin-bottom: 32rpx; }
.invite-desc { font-size: 24rpx; color: #8D6E63; line-height: 1.6; margin-bottom: 24rpx; }
.invite-btn { height: 88rpx; border-radius: 44rpx; background: linear-gradient(135deg, #7CB342, #8BC34A); color: #fff; font-size: 28rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; }
.invite-btn::after { border: none; }

.invite-code-card { background: #F5F5F5; border-radius: 16rpx; padding: 24rpx; margin-top: 24rpx; text-align: center; }
.invite-code-label { font-size: 24rpx; color: #8D6E63; display: block; margin-bottom: 8rpx; }
.invite-code-text { font-size: 40rpx; font-weight: bold; color: #3E2723; letter-spacing: 8rpx; display: block; margin-bottom: 20rpx; }
.invite-code-actions { display: flex; gap: 16rpx; justify-content: center; }
.code-btn { height: 64rpx; line-height: 64rpx; padding: 0 32rpx; border-radius: 32rpx; background: #7CB342; color: #fff; font-size: 24rpx; }
.code-btn::after { border: none; }
.code-btn.share { background: #FF9800; }

/* 危险区域 */
.danger-section { margin-top: 32rpx; }
.danger-btn { background: #fff; border-radius: 20rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #E91E63; }

/* 弹窗 */
.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; }
.modal-panel { width: 600rpx; background: #fff; border-radius: 32rpx; padding: 48rpx 32rpx; }
.modal-title { font-size: 32rpx; font-weight: bold; color: #3E2723; text-align: center; display: block; margin-bottom: 32rpx; }
.modal-input { height: 88rpx; background: #F5F5F5; border-radius: 16rpx; padding: 0 24rpx; font-size: 28rpx; margin-bottom: 32rpx; }
.modal-actions { display: flex; gap: 24rpx; }
.modal-btn { flex: 1; height: 80rpx; border-radius: 40rpx; font-size: 28rpx; line-height: 80rpx; }
.modal-btn::after { border: none; }
.modal-btn.cancel { background: #F5F5F5; color: #8D6E63; }
.modal-btn.confirm { background: linear-gradient(135deg, #7CB342, #8BC34A); color: #fff; }
