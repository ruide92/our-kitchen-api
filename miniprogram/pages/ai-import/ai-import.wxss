.page { padding: 24rpx 32rpx; min-height: 100vh; padding-bottom: 160rpx; }
.header { margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #3E2723; }
.tip-card { background: #E3F2FD; border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; }
.tip-title { font-size: 28rpx; font-weight: bold; color: #1976D2; display: block; margin-bottom: 12rpx; }
.tip-text { font-size: 24rpx; color: #5D4037; display: block; margin-bottom: 8rpx; }
.action-btn { height: 80rpx; border-radius: 40rpx; background: #7CB342; color: #fff; font-size: 28rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; }
.action-btn.outline { background: #fff; color: #7CB342; border: 2rpx solid #7CB342; }
.skill-box { background: #F5F5F5; border-radius: 16rpx; padding: 20rpx; margin-bottom: 24rpx; }
.skill-text { font-size: 24rpx; color: #8D6E63; line-height: 1.6; }
.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #8D6E63; margin-bottom: 12rpx; display: block; }
.form-textarea { width: 100%; height: 400rpx; background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; font-size: 26rpx; box-sizing: border-box; }
.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06); }
.import-btn { height: 88rpx; border-radius: 44rpx; background: linear-gradient(135deg, #7CB342, #8BC34A); color: #fff; font-size: 30rpx; display: flex; align-items: center; justify-content: center; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
