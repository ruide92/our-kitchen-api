/* 购物清单 Tab V4 fixture — 延续首页/菜单/冰箱温暖家庭风 */
.page {
  padding: 0 0 calc(100rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background: #FFF9F0;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.page-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 0 24rpx;
}

/* ===== 顶部标题区 ===== */
.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #3E2723;
}

.header-summary {
  font-size: 22rpx;
  color: #A1887F;
  margin-top: 6rpx;
}

.header-add {
  display: flex;
  align-items: center;
  background: #7CB342;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.header-add-icon {
  color: #FFFFFF;
  font-size: 26rpx;
  margin-right: 6rpx;
}

.header-add-text {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
}

/* ===== 本餐来源卡 ===== */
.source-card {
  margin: 0 24rpx 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  position: relative;
}

.source-label {
  font-size: 20rpx;
  color: #A1887F;
  display: block;
}

.source-meal {
  font-size: 30rpx;
  font-weight: 600;
  color: #3E2723;
  margin-top: 4rpx;
  display: block;
}

.source-recipes {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.source-recipe {
  font-size: 22rpx;
  color: #5D4037;
  background: #F5F0E8;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.source-diners {
  font-size: 22rpx;
  color: #8D6E63;
  margin-top: 8rpx;
  display: block;
}

.source-action {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
}

.source-action text {
  font-size: 24rpx;
  color: #7CB342;
  font-weight: 500;
}

.source-note {
  font-size: 20rpx;
  color: #BCAAA4;
  margin-top: 8rpx;
  display: block;
}

/* ===== 购买进度 ===== */
.progress-section {
  margin: 0 24rpx 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #3E2723;
}

.progress-count {
  font-size: 24rpx;
  color: #7CB342;
  font-weight: 500;
}

.progress-bar {
  height: 8rpx;
  background: #F0EBE3;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
}

.progress-fill {
  height: 100%;
  background: #7CB342;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.filter-chips {
  display: flex;
  gap: 12rpx;
}

.filter-chip {
  font-size: 22rpx;
  color: #8D6E63;
  background: #F5F0E8;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
}

.filter-active {
  background: #7CB342;
  color: #FFFFFF;
  font-weight: 500;
}

/* ===== 购物列表 ===== */
.shopping-list {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.cat-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8D6E63;
  padding: 16rpx 0 8rpx;
}

.shop-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 10rpx;
}

.shop-item-purchased {
  opacity: 0.55;
}

.shop-item-purchased .item-name {
  text-decoration: line-through;
}

.item-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #C5E1A5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FFFFFF;
}

.checkbox-checked {
  background: #7CB342;
  border-color: #7CB342;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #3E2723;
  display: block;
}

.item-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}

.item-qty {
  font-size: 22rpx;
  color: #8D6E63;
}

.item-badge {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.badge-generated {
  background: #E8F5E9;
  color: #558B2F;
}

.badge-manual {
  background: #F5F0E8;
  color: #8D6E63;
}

.badge-unit {
  background: #FFF3E0;
  color: #EF6C00;
}

.item-arrow {
  font-size: 32rpx;
  color: #BCAAA4;
  padding: 0 8rpx;
  flex-shrink: 0;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #5D4037;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #A1887F;
  margin-bottom: 24rpx;
  text-align: center;
}

.empty-add {
  display: flex;
  align-items: center;
  background: #7CB342;
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
}

.empty-add-icon {
  color: #FFFFFF;
  font-size: 28rpx;
  margin-right: 8rpx;
}

.empty-add text {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
}

/* ===== sticky 完成采购 ===== */
.complete-bar {
  margin: 0 24rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(92, 74, 58, 0.1);
  flex-shrink: 0;
}

.complete-count {
  font-size: 26rpx;
  color: #3E2723;
  font-weight: 500;
}

.complete-btn {
  background: #E0E0E0;
  color: #9E9E9E;
  font-size: 26rpx;
  font-weight: 500;
  padding: 14rpx 36rpx;
  border-radius: 20rpx;
}

.complete-btn-active {
  background: #7CB342;
  color: #FFFFFF;
}

/* ===== bottom sheet ===== */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.sheet-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin: 0 auto 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3E2723;
  text-align: center;
  display: block;
}

.sheet-subtitle {
  font-size: 24rpx;
  color: #A1887F;
  text-align: center;
  display: block;
  margin-top: 6rpx;
  margin-bottom: 20rpx;
}

/* evidence */
.evidence-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F5F0E8;
}

.evidence-label {
  font-size: 26rpx;
  color: #8D6E63;
}

.evidence-value {
  font-size: 26rpx;
  color: #3E2723;
  font-weight: 500;
}

.evidence-highlight {
  background: #E8F5E9;
  margin: 12rpx -24rpx;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  border-bottom: none;
}

.evidence-missing {
  color: #558B2F;
  font-weight: 700;
}

.evidence-sources {
  margin-top: 20rpx;
}

.evidence-sources-title {
  font-size: 24rpx;
  color: #8D6E63;
  margin-bottom: 10rpx;
  display: block;
}

.evidence-source-item {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.evidence-source-name {
  font-size: 26rpx;
  color: #3E2723;
}

.evidence-source-qty {
  font-size: 26rpx;
  color: #8D6E63;
}

.unit-warning {
  margin-top: 16rpx;
  background: #FFF3E0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

.unit-warning text {
  font-size: 22rpx;
  color: #EF6C00;
  line-height: 1.5;
}

/* complete list */
.complete-list {
  margin: 16rpx 0;
}

.complete-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F0E8;
}

.complete-item-name {
  font-size: 26rpx;
  color: #3E2723;
}

.complete-item-qty {
  font-size: 26rpx;
  color: #7CB342;
  font-weight: 500;
}

.complete-note {
  margin-top: 16rpx;
  background: #F5F0E8;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
}

.complete-note text {
  font-size: 22rpx;
  color: #8D6E63;
  line-height: 1.5;
}

/* 表单 */
.form-item {
  margin-bottom: 20rpx;
}

.form-half {
  flex: 1;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-label {
  font-size: 24rpx;
  color: #8D6E63;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  height: 76rpx;
  background: #F5F0E8;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #3E2723;
  box-sizing: border-box;
}

.form-picker {
  height: 76rpx;
  background: #F5F0E8;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.picker-text {
  font-size: 26rpx;
  color: #3E2723;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.sheet-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.sheet-btn-cancel {
  background: #F5F0E8;
  color: #8D6E63;
}

.sheet-btn-confirm {
  background: #7CB342;
  color: #FFFFFF;
}

.sheet-btn-danger {
  background: #FFEBEE;
  color: #E57373;
  flex: 0.8;
}
