.page {
  padding: 24rpx 32rpx;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 顶部操作 */
.top-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.action-generate {
  background: #E8F5E9;
  color: #7CB342;
}

.action-add {
  background: #FFF3E0;
  color: #FF9800;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #8D6E63;
}

.check-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #BDBDBD;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
}

.checkbox-checked {
  background: #7CB342;
  border-color: #7CB342;
}

/* 分类标题 */
.category-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #7CB342;
  padding: 16rpx 0 12rpx;
  border-bottom: 2rpx solid #E8F5E9;
  margin-bottom: 12rpx;
}

/* 购物项 */
.shopping-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #FAFAFA;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
}

.item-checked .item-name {
  text-decoration: line-through;
  color: #BDBDBD;
}

.item-name {
  font-size: 28rpx;
  color: #3E2723;
  display: block;
}

.item-amount {
  font-size: 24rpx;
  color: #8D6E63;
  margin-top: 4rpx;
  display: block;
}

.item-tag {
  background: #E8F5E9;
  color: #7CB342;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.item-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #BDBDBD;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8D6E63;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #BDBDBD;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 20rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  z-index: 50;
}

.bottom-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.bottom-count {
  font-size: 36rpx;
  font-weight: bold;
  color: #7CB342;
}

.bottom-text {
  font-size: 26rpx;
  color: #8D6E63;
}

.bottom-btn {
  flex: 1;
  margin-left: 32rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #E0E0E0;
  color: #FFFFFF;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-btn-active {
  background: linear-gradient(135deg, #7CB342, #8BC34A);
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-panel {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
  text-align: center;
  margin-bottom: 32rpx;
  display: block;
}

.form-item { margin-bottom: 24rpx; }
.form-item-half { flex: 1; }
.form-row { display: flex; gap: 24rpx; }
.form-label {
  font-size: 26rpx;
  color: #8D6E63;
  margin-bottom: 12rpx;
  display: block;
}
.form-input {
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.form-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.form-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.form-btn-cancel { background: #F5F5F5; color: #8D6E63; }
.form-btn-confirm { background: linear-gradient(135deg, #7CB342, #8BC34A); color: #FFFFFF; }

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
