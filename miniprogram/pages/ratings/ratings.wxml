<view class="page">
  <view class="header"><text class="title">我的评分</text></view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{loadError}}" class="loading">
    <text class="empty-icon">⚠️</text>
    <text class="empty-text">{{loadError}}</text>
    <view class="empty-btn" bindtap="retryLoad">重新加载</view>
  </view>

  <view wx:else class="list">
    <view wx:for="{{dishes}}" wx:key="recipe_id" class="dish-card" data-id="{{item.recipe_id}}" bindtap="goDetail">
      <view class="dish-info">
        <text class="dish-name">{{item.name}}</text>
        <view class="stars">{{item.stars}}</view>
      </view>
      <view class="rating-remove" data-id="{{item.recipe_id}}" catchtap="removeRating">取消</view>
    </view>
    <view wx:if="{{dishes.length === 0}}" class="empty">
      <text class="empty-icon">⭐</text>
      <text class="empty-text">还没有评分记录</text>
    </view>
  </view>
</view>
