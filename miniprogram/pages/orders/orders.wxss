.page { padding: 24rpx 32rpx; min-height: 100vh; }
.header { margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #3E2723; }
.filters { display: flex; flex-wrap: wrap; margin-bottom: 24rpx; }
.filter { padding: 10rpx 24rpx; background: #fff; border-radius: 20rpx; font-size: 24rpx; color: #8D6E63; margin-right: 16rpx; margin-bottom: 12rpx; }
.filter.active { background: #7CB342; color: #fff; }
.order-item { display: flex; align-items: center; background: #fff; border-radius: 20rpx; padding: 20rpx; margin-bottom: 16rpx; }
.dish-img { width: 120rpx; height: 90rpx; border-radius: 16rpx; margin-right: 20rpx; }
.order-info { flex: 1; }
.dish-name { font-size: 28rpx; font-weight: 500; color: #3E2723; display: block; }
.order-meta { font-size: 22rpx; color: #BDBDBD; margin-top: 4rpx; display: block; }
.order-status { display: inline-block; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 10rpx; margin-top: 8rpx; }
.status-WANTED { background: #FFF3E0; color: #FF9800; }
.status-COMPLETED { background: #E8F5E9; color: #7CB342; }
.status-CANCELLED { background: #F5F5F5; color: #9E9E9E; }
.action-btn { font-size: 24rpx; color: #E91E63; padding: 8rpx 16rpx; }
.action-btn.restore { color: #7CB342; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 26rpx; color: #BDBDBD; }
