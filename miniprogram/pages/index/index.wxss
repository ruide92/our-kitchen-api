/* 首页 Phase 2.5 — 温暖家庭风 */
.page {
  padding: 12rpx 24rpx 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #FFF9F0;
}

/* ===== 1. 顶部家庭区 ===== */
.family-header {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 16rpx;
}

.family-avatars {
  position: relative;
  width: 130rpx;
  height: 80rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.avatar {
  position: absolute;
  top: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #FFF9F0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar-left {
  left: 0;
  z-index: 2;
  background: linear-gradient(135deg, #81D4FA, #4FC3F7);
}

.avatar-right {
  left: 48rpx;
  z-index: 1;
  background: linear-gradient(135deg, #F8BBD0, #F48FB1);
}

.avatar-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.family-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.kitchen-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #3E2723;
  line-height: 1.2;
}

.family-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #8D6E63;
}

.meta-dot {
  font-size: 24rpx;
  color: #BCAAA4;
  margin: 0 10rpx;
}

/* ===== 2. 四个快捷入口 ===== */
.quick-panel {
  display: flex;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 18rpx 12rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(92, 74, 58, 0.06);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.quick-icon-orange { background: #FFF3E0; }
.quick-icon-green  { background: #E8F5E9; }
.quick-icon-pink   { background: #FCE4EC; }
.quick-icon-blue   { background: #E3F2FD; }

.quick-text {
  font-size: 25rpx;
  color: #5D4037;
  font-weight: 500;
}

/* ===== 3. 本周菜谱（核心区域） ===== */
.weekly-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 20rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(92, 74, 58, 0.08);
}

.weekly-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.weekly-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3E2723;
}

.weekly-action {
  display: flex;
  align-items: center;
}

.weekly-action-text {
  font-size: 24rpx;
  color: #7CB342;
  font-weight: 500;
}

.weekly-action-arrow {
  font-size: 32rpx;
  color: #7CB342;
  margin-left: 2rpx;
  line-height: 1;
}

/* 日期标签 */
.week-tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.week-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 88rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
  background: #FAF7F2;
}

.week-tab-label {
  font-size: 24rpx;
  color: #8D6E63;
  font-weight: 500;
}

.week-tab-date {
  font-size: 18rpx;
  color: #BCAAA4;
  margin-top: 4rpx;
}

.week-tab-today .week-tab-label {
  color: #7CB342;
  font-weight: 700;
}

.week-tab-active {
  background: #7CB342;
}

.week-tab-active .week-tab-label,
.week-tab-active .week-tab-date {
  color: #FFFFFF;
}

/* 三餐纵向三行 */
.meals-vertical {
  display: flex;
  flex-direction: column;
}

.meal-row {
  background: #FAF7F2;
  border-radius: 24rpx;
  padding: 14rpx 16rpx 12rpx;
  margin-bottom: 12rpx;
}

.meal-row:last-child {
  margin-bottom: 0;
}

.meal-row-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.meal-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.meal-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #3E2723;
  flex: 1;
}

.meal-count {
  font-size: 20rpx;
  color: #A1887F;
  background: #EFEBE9;
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
}

.meal-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.meal-empty-text {
  font-size: 22rpx;
  color: #BCAAA4;
}

/* 本餐菜品横向排列 */
.meal-dishes-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.meal-dish-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
}

.meal-dish-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 6rpx;
  position: relative;
}

.meal-dish-img {
  width: 120rpx;
  height: 120rpx;
  display: block;
}

.meal-dish-ph {
  width: 120rpx;
  height: 120rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meal-dish-ph-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #5D4037;
}

.meal-dish-name {
  font-size: 21rpx;
  color: #3E2723;
  font-weight: 500;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.meal-dish-lock {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  font-size: 18rpx;
}

/* 一键加入本餐菜单（餐次级） */
.meal-add-all {
  background: #7CB342;
  border-radius: 14rpx;
  padding: 9rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meal-add-all-text {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 4. 已点菜单 ===== */
.meal-card-section {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 18rpx 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(92, 74, 58, 0.08);
}

.meal-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.meal-section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3E2723;
}

.meal-section-action {
  display: flex;
  align-items: center;
}

.meal-section-action-text {
  font-size: 24rpx;
  color: #7CB342;
  font-weight: 500;
}

.meal-section-arrow {
  font-size: 32rpx;
  color: #7CB342;
  margin-left: 4rpx;
  line-height: 1;
}

.meal-empty-state {
  padding: 24rpx 0;
  text-align: center;
}

.meal-empty-hint {
  font-size: 24rpx;
  color: #BCAAA4;
}

/* 已点菜单横向卡片 */
.ordered-scroll {
  white-space: nowrap;
}

.ordered-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  margin-right: 16rpx;
  vertical-align: top;
}

.ordered-card-thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.ordered-card-img {
  width: 110rpx;
  height: 110rpx;
  display: block;
}

.ordered-card-ph {
  width: 110rpx;
  height: 110rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ordered-card-ph-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #5D4037;
}

.ordered-card-name {
  font-size: 22rpx;
  color: #3E2723;
  font-weight: 600;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.ordered-card-by {
  font-size: 18rpx;
  color: #E91E63;
  margin-top: 4rpx;
  font-weight: 500;
}

/* "+ 继续添加" 轻量卡片 */
.ordered-card-add {
  border: 2rpx dashed #C8E6C9;
  border-radius: 22rpx;
  height: 110rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F1F8E9;
}

.ordered-card-add-icon {
  font-size: 36rpx;
  color: #7CB342;
  font-weight: 300;
  line-height: 1;
}

.ordered-card-add-text {
  font-size: 18rpx;
  color: #7CB342;
  margin-top: 6rpx;
  font-weight: 500;
}

/* 底部留白：TabBar 高度 + iPhone safe-area，确保已点菜单不被遮挡 */
.bottom-space {
  height: calc(110rpx + env(safe-area-inset-bottom));
}
