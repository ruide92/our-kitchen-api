/* 首页 Phase 2.5 — 温暖家庭风 */
.page {
  padding: 20rpx 28rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #FFF9F0;
}

/* ===== 1. 顶部家庭区 ===== */
.family-header {
  display: flex;
  align-items: center;
  padding: 12rpx 8rpx 24rpx;
}

.family-avatars {
  position: relative;
  width: 130rpx;
  height: 80rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.avatar {
  position: absolute;
  top: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #FFF9F0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar-left {
  left: 0;
  z-index: 2;
  background: linear-gradient(135deg, #81D4FA, #4FC3F7);
}

.avatar-right {
  left: 48rpx;
  z-index: 1;
  background: linear-gradient(135deg, #F8BBD0, #F48FB1);
}

.avatar-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.family-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.kitchen-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #3E2723;
  line-height: 1.2;
}

.family-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #8D6E63;
}

.meta-dot {
  font-size: 24rpx;
  color: #BCAAA4;
  margin: 0 10rpx;
}

/* ===== 2. 四个快捷入口 ===== */
.quick-panel {
  display: flex;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(92, 74, 58, 0.06);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

.quick-icon-orange { background: #FFF3E0; }
.quick-icon-green  { background: #E8F5E9; }
.quick-icon-pink   { background: #FCE4EC; }
.quick-icon-blue   { background: #E3F2FD; }

.quick-text {
  font-size: 22rpx;
  color: #5D4037;
  font-weight: 500;
}

/* ===== 3. 本周菜谱（核心区域） ===== */
.weekly-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(92, 74, 58, 0.08);
}

.weekly-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.weekly-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3E2723;
}

.weekly-action {
  display: flex;
  align-items: center;
}

.weekly-action-text {
  font-size: 24rpx;
  color: #7CB342;
  font-weight: 500;
}

.weekly-action-arrow {
  font-size: 32rpx;
  color: #7CB342;
  margin-left: 2rpx;
  line-height: 1;
}

/* 日期标签 */
.week-tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.week-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 88rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
  background: #FAF7F2;
}

.week-tab-label {
  font-size: 24rpx;
  color: #8D6E63;
  font-weight: 500;
}

.week-tab-date {
  font-size: 18rpx;
  color: #BCAAA4;
  margin-top: 4rpx;
}

.week-tab-today .week-tab-label {
  color: #7CB342;
  font-weight: 700;
}

.week-tab-active {
  background: #7CB342;
}

.week-tab-active .week-tab-label,
.week-tab-active .week-tab-date {
  color: #FFFFFF;
}

/* 三餐列 */
.meals-container {
  display: flex;
}

.meal-column {
  flex: 1;
  background: #FAF7F2;
  border-radius: 24rpx;
  padding: 16rpx 12rpx;
  min-height: 200rpx;
  margin: 0 6rpx;
}

.meal-column:first-child { margin-left: 0; }
.meal-column:last-child { margin-right: 0; }

.meal-column-header {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #F0EBE5;
}

.meal-icon {
  font-size: 26rpx;
  margin-right: 6rpx;
}

.meal-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #3E2723;
  flex: 1;
}

.meal-count {
  font-size: 18rpx;
  color: #A1887F;
  background: #EFEBE9;
  border-radius: 12rpx;
  padding: 2rpx 10rpx;
}

.meal-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
}

.meal-empty-text {
  font-size: 20rpx;
  color: #BCAAA4;
}

/* 菜品行 */
.dish-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  position: relative;
}

.dish-thumb {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 10rpx;
}

.dish-thumb-img {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.dish-thumb-ph {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dish-thumb-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #5D4037;
}

.dish-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-size: 22rpx;
  color: #3E2723;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-lock {
  font-size: 16rpx;
  color: #FF9800;
  margin-top: 2rpx;
}

.dish-add-btn {
  flex-shrink: 0;
  background: #7CB342;
  border-radius: 16rpx;
  padding: 6rpx 14rpx;
  margin-left: 8rpx;
}

.dish-add-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 4. 已点菜单 ===== */
.meal-card-section {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(92, 74, 58, 0.08);
}

.meal-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.meal-section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3E2723;
}

.meal-section-action {
  display: flex;
  align-items: center;
}

.meal-section-action-text {
  font-size: 24rpx;
  color: #7CB342;
  font-weight: 500;
}

.meal-section-arrow {
  font-size: 32rpx;
  color: #7CB342;
  margin-left: 4rpx;
  line-height: 1;
}

.meal-empty-state {
  padding: 24rpx 0;
  text-align: center;
}

.meal-empty-hint {
  font-size: 24rpx;
  color: #BCAAA4;
}

.ordered-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #F5F0EB;
}

.ordered-item:last-child {
  border-bottom: none;
}

.ordered-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.ordered-thumb-img {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.ordered-thumb-ph {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ordered-thumb-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #5D4037;
}

.ordered-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ordered-name {
  font-size: 28rpx;
  color: #3E2723;
  font-weight: 600;
}

.ordered-by {
  font-size: 22rpx;
  color: #E91E63;
  margin-top: 4rpx;
  font-weight: 500;
}

.bottom-space {
  height: 32rpx;
}
