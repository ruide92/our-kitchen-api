<view class="page">
  <view class="header"><text class="title">我的收藏</text></view>
  <view class="list">
    <view wx:for="{{dishes}}" wx:key="id" class="dish-card" data-id="{{item.dish_id || item.id}}" bindtap="goDetail">
      <image class="dish-img" src="{{item.image || item.dish_image}}" mode="aspectFill"></image>
      <view class="dish-info">
        <text class="dish-name">{{item.name || item.dish_name}}</text>
        <text class="dish-desc">{{item.category || '家常菜'}}</text>
      </view>
      <view class="fav-btn" data-id="{{item.id}}" catchtap="removeFavorite">❤️</view>
    </view>
    <view wx:if="{{dishes.length === 0}}" class="empty"><text class="empty-icon">⭐</text><text class="empty-text">还没有收藏的菜品</text></view>
  </view>
</view>
