<view class="page">
  <view class="header"><text class="title">🗑️ 回收站</text></view>
  <view class="tip">删除的菜品会在这里保留30天，可以恢复或永久删除</view>
  <view class="list">
    <view wx:for="{{items}}" wx:key="id" class="item">
      <image class="item-img" src="{{item.image}}" mode="aspectFill"></image>
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-time">删除于 {{item.deleted_at}}</text>
      </view>
      <view class="item-actions">
        <view class="action-btn restore" data-id="{{item.id}}" bindtap="restore">恢复</view>
        <view class="action-btn delete" data-id="{{item.id}}" bindtap="deleteForever">删除</view>
      </view>
    </view>
    <view wx:if="{{items.length === 0}}" class="empty"><text class="empty-icon">🗑️</text><text class="empty-text">回收站是空的</text></view>
  </view>
</view>
