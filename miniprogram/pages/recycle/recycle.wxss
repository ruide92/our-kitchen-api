.page { padding: 24rpx 32rpx; min-height: 100vh; }
.header { margin-bottom: 16rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #3E2723; }
.tip { font-size: 24rpx; color: #BDBDBD; margin-bottom: 24rpx; }
.item { display: flex; align-items: center; background: #fff; border-radius: 20rpx; padding: 20rpx; margin-bottom: 16rpx; }
.item-img { width: 120rpx; height: 90rpx; border-radius: 16rpx; margin-right: 20rpx; }
.item-info { flex: 1; }
.item-name { font-size: 28rpx; font-weight: 500; color: #3E2723; display: block; }
.item-time { font-size: 22rpx; color: #BDBDBD; margin-top: 4rpx; display: block; }
.item-actions { display: flex; flex-direction: column; gap: 8rpx; }
.action-btn { font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 16rpx; text-align: center; }
.action-btn.restore { background: #E8F5E9; color: #7CB342; }
.action-btn.delete { background: #FFEBEE; color: #E91E63; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 26rpx; color: #BDBDBD; }
