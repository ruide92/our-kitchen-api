.page { padding: 24rpx 32rpx; min-height: 100vh; padding-bottom: 160rpx; }
.header { margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #3E2723; }
.form-item { margin-bottom: 24rpx; }
.form-item-half { flex: 1; }
.form-row { display: flex; gap: 24rpx; }
.form-label { font-size: 26rpx; color: #8D6E63; margin-bottom: 12rpx; display: block; }
.form-input { height: 80rpx; background: #fff; border-radius: 16rpx; padding: 0 24rpx; font-size: 28rpx; }
.form-textarea { width: 100%; height: 200rpx; background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; font-size: 28rpx; box-sizing: border-box; }
.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06); }
.save-btn { height: 88rpx; border-radius: 44rpx; background: linear-gradient(135deg, #7CB342, #8BC34A); color: #fff; font-size: 30rpx; display: flex; align-items: center; justify-content: center; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
