/* 我的 Tab V4 fixture — 延续首页/菜单/冰箱/购物温暖家庭风 */
.page {
  padding: 0 0 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #FFF9F0;
}

/* ===== 页面标题 ===== */
.page-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #3E2723;
  padding: 24rpx 24rpx 8rpx;
}

/* ===== 个人区 ===== */
.profile-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-owner {
  background: linear-gradient(135deg, #AED581, #7CB342);
}

.avatar-member {
  background: linear-gradient(135deg, #FFCC80, #FFB74D);
}

.avatar-text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.avatar-large {
  width: 140rpx;
  height: 140rpx;
}

.avatar-large .avatar-text {
  font-size: 44rpx;
}

.profile-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #3E2723;
  display: block;
}

.profile-sub {
  font-size: 24rpx;
  color: #A1887F;
  margin-top: 6rpx;
  display: block;
}

.profile-arrow {
  font-size: 36rpx;
  color: #BCAAA4;
  padding: 0 8rpx;
}

/* ===== 家庭卡 ===== */
.family-card {
  margin: 8rpx 24rpx 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
}

.family-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.family-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #3E2723;
  display: block;
}

.family-members {
  font-size: 24rpx;
  color: #8D6E63;
  margin-top: 4rpx;
  display: block;
}

.family-avatars {
  display: flex;
}

.mini-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -12rpx;
  border: 3rpx solid #FFFFFF;
}

.mini-avatar:first-child {
  margin-left: 0;
}

.mini-avatar-text {
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 500;
}

.family-role-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F0E8;
}

.family-role-badge {
  font-size: 22rpx;
  color: #558B2F;
  background: #E8F5E9;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.family-manage {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #7CB342;
  font-weight: 500;
}

.family-manage .arrow {
  margin-left: 4rpx;
  font-size: 28rpx;
}

.family-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.family-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F0E8;
  border-radius: 14rpx;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #5D4037;
}

.family-btn-icon {
  margin-right: 8rpx;
  font-size: 26rpx;
}

/* ===== 轻量统计 ===== */
.stats-row {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 0;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #3E2723;
}

.stat-label {
  font-size: 22rpx;
  color: #A1887F;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #F0EBE3;
}

/* ===== 功能菜单 ===== */
.menu-groups {
  padding: 0 24rpx;
}

.menu-group {
  margin-bottom: 20rpx;
}

.menu-group-title {
  font-size: 24rpx;
  color: #8D6E63;
  font-weight: 500;
  padding: 0 8rpx 10rpx;
  display: block;
}

.menu-group-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #F5F0E8;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  width: 40rpx;
  text-align: center;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: #3E2723;
}

.menu-badge {
  font-size: 20rpx;
  color: #A1887F;
  background: #F5F0E8;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: 30rpx;
  color: #BCAAA4;
}

.page-bottom-space {
  height: 40rpx;
}

/* ===== bottom sheet ===== */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.sheet-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin: 0 auto 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3E2723;
  text-align: center;
  display: block;
}

.sheet-subtitle {
  font-size: 24rpx;
  color: #A1887F;
  text-align: center;
  display: block;
  margin-top: 6rpx;
  margin-bottom: 20rpx;
}

.sheet-note {
  font-size: 22rpx;
  color: #A1887F;
  line-height: 1.5;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #F5F0E8;
  border-radius: 12rpx;
}

/* profile sheet */
.profile-sheet-avatar {
  display: flex;
  justify-content: center;
  margin: 20rpx 0;
}

/* member list */
.member-list {
  margin: 16rpx 0;
}

.member-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F0E8;
}

.member-row:last-child {
  border-bottom: none;
}

.member-info {
  flex: 1;
  margin-left: 16rpx;
}

.member-name {
  font-size: 28rpx;
  color: #3E2723;
  font-weight: 500;
  display: block;
}

.member-role {
  font-size: 22rpx;
  color: #A1887F;
  display: block;
  margin-top: 2rpx;
}

.member-role-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.badge-owner {
  background: #E8F5E9;
  color: #558B2F;
}

.badge-member {
  background: #FFF3E0;
  color: #EF6C00;
}

.family-sheet-action {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #F5F0E8;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #3E2723;
}

.family-sheet-action-icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}

.family-sheet-action .arrow {
  margin-left: auto;
  color: #BCAAA4;
  font-size: 30rpx;
}

/* invite code */
.invite-code-box {
  background: #F5F0E8;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  margin: 24rpx 0;
}

.invite-code-label {
  font-size: 24rpx;
  color: #8D6E63;
  display: block;
  margin-bottom: 8rpx;
}

.invite-code {
  font-size: 48rpx;
  font-weight: 700;
  color: #7CB342;
  letter-spacing: 8rpx;
  display: block;
}

/* setting list */
.setting-list {
  margin: 16rpx 0;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F0E8;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 26rpx;
  color: #5D4037;
}

.setting-value {
  font-size: 26rpx;
  color: #8D6E63;
  text-align: right;
  max-width: 60%;
}

.setting-value-multi {
  font-size: 22rpx;
  line-height: 1.4;
}

.setting-arrow {
  font-size: 28rpx;
  color: #BCAAA4;
}

.setting-group {
  margin-bottom: 16rpx;
}

.setting-group-title {
  font-size: 24rpx;
  color: #8D6E63;
  font-weight: 500;
  padding: 12rpx 0 8rpx;
  display: block;
}

/* 表单 */
.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 24rpx;
  color: #8D6E63;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  height: 76rpx;
  background: #F5F0E8;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #3E2723;
  box-sizing: border-box;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.sheet-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.sheet-btn-cancel {
  background: #F5F0E8;
  color: #8D6E63;
}

.sheet-btn-confirm {
  background: #7CB342;
  color: #FFFFFF;
}
