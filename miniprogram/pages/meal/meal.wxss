.page {
  padding: 0 0 calc(140rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background: #FFF9F0;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
}

.header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #3E2723;
}

.header-sub {
  font-size: 22rpx;
  color: #A1887F;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.diners-control {
  display: inline-flex;
  align-items: center;
  background: #F5F0E8;
  border-radius: 20rpx;
  padding: 2rpx 8rpx;
}

.diners-btn {
  font-size: 28rpx;
  color: #7CB342;
  padding: 0 12rpx;
  font-weight: 600;
}

.diners-count {
  font-size: 22rpx;
  color: #5D4037;
  min-width: 60rpx;
  text-align: center;
}

.header-add {
  display: flex;
  align-items: center;
  background: #7CB342;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.header-add-icon { color: #FFF; font-size: 26rpx; margin-right: 6rpx; }
.header-add-text { color: #FFF; font-size: 24rpx; font-weight: 500; }

.loading { text-align: center; padding: 80rpx; color: #A1887F; }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 32rpx; color: #5D4037; font-weight: 600; }
.empty-sub { font-size: 24rpx; color: #A1887F; margin-top: 8rpx; }

.empty-btn {
  margin-top: 32rpx;
  background: #7CB342;
  color: #FFF;
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.meal-list { padding: 0 24rpx; }

.meal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(92,74,58,0.06);
}

.meal-item-name { font-size: 30rpx; color: #3E2723; font-weight: 600; display: block; }
.meal-item-meta { font-size: 22rpx; color: #A1887F; margin-top: 6rpx; display: block; }

.meal-item-remove {
  color: #E57373;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF;
  padding: 20rpx 32rpx;
  box-shadow: 0 -2rpx 12rpx rgba(92,74,58,0.08);
  z-index: 50;
}

.action-count { font-size: 26rpx; color: #5D4037; font-weight: 500; }

.action-btn {
  background: #7CB342;
  color: #FFF;
  padding: 16rpx 36rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.bottom-space { height: calc(130rpx + env(safe-area-inset-bottom)); }

.header-sub { display: flex; align-items: center; gap: 16rpx; margin-top: 8rpx; }
.header-date { font-size: 24rpx; color: #8D6E63; }

/* Status tags */
.header-status { display: flex; align-items: center; }
.status-tag { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 16rpx; font-weight: 600; }
.status-PLANNING { background: #FFF3E0; color: #F57C00; }
.status-CONFIRMED { background: #E8F5E9; color: #388E3C; }
.status-COOKING { background: #E3F2FD; color: #1976D2; }
.status-COMPLETED { background: #F3E5F5; color: #7B1FA2; }

.diners-count-fixed { font-size: 24rpx; color: #5D4037; font-weight: 500; }

/* Cooking view */
.cooking-view {
  min-height: 100vh;
  background: #FFF9F0;
  display: flex;
  flex-direction: column;
}
.cooking-header {
  padding: 32rpx 24rpx 20rpx;
  background: linear-gradient(135deg, #7CB342, #558B2F);
}
.cooking-title { font-size: 40rpx; font-weight: 700; color: #FFF; display: block; }
.cooking-sub { font-size: 26rpx; color: #DCEDC8; margin-top: 6rpx; display: block; }
.cooking-session { font-size: 20rpx; color: #AED581; margin-top: 4rpx; display: block; word-break: break-all; }
.cooking-steps { flex: 1; padding: 24rpx; }
.cooking-step {
  display: flex;
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(92,74,58,0.06);
}
.cooking-step-recipe { font-size: 24rpx; color: #7CB342; font-weight: 600; margin-bottom: 8rpx; width: 100%; }
.cooking-step-num {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #7CB342; color: #FFF;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; flex-shrink: 0; margin-right: 20rpx;
}
.cooking-step-content { flex: 1; }
.cooking-step-title { font-size: 28rpx; color: #3E2723; font-weight: 600; display: block; }
.cooking-step-text { font-size: 26rpx; color: #5D4037; margin-top: 6rpx; display: block; line-height: 1.6; }
.cooking-step-time { font-size: 22rpx; color: #FF8F00; margin-top: 8rpx; display: block; }
.cooking-step-tip { font-size: 22rpx; color: #00897B; margin-top: 6rpx; display: block; }
.cooking-footer {
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFF;
  box-shadow: 0 -2rpx 12rpx rgba(92,74,58,0.08);
}
.cooking-footer .action-btn { text-align: center; }

.btn-busy { opacity: 0.5; pointer-events: none; }

/* Completed banner */
.completed-banner {
  margin: 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  border-radius: 16rpx;
  text-align: center;
}
.completed-icon { font-size: 60rpx; display: block; }
.completed-title { font-size: 32rpx; color: #2E7D32; font-weight: 700; display: block; margin-top: 8rpx; }
.completed-sub { font-size: 24rpx; color: #558B2F; margin-top: 4rpx; display: block; }

/* Cooking unavailable */
.cooking-unavailable {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

/* Completion overlay */
.completion-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.completion-sheet {
  width: 100%;
  background: #FFF;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}
.completion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 12rpx;
}
.completion-title { font-size: 32rpx; font-weight: 700; color: #3E2723; }
.completion-close { font-size: 32rpx; color: #A1887F; padding: 8rpx; }
.completion-subtitle { font-size: 24rpx; color: #8D6E63; padding: 0 32rpx 16rpx; }
.completion-list { flex: 1; padding: 0 32rpx; max-height: 50vh; }
.completion-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0EBE3;
}
.completion-item-info { flex: 1; }
.completion-item-name { font-size: 28rpx; color: #3E2723; font-weight: 600; display: block; }
.completion-item-meta { font-size: 22rpx; color: #A1887F; margin-top: 4rpx; display: block; }
.completion-item-input { display: flex; align-items: center; gap: 8rpx; }
.completion-input {
  width: 120rpx;
  text-align: center;
  background: #F5F0E8;
  border-radius: 12rpx;
  padding: 12rpx 8rpx;
  font-size: 28rpx;
  color: #3E2723;
}
.completion-unit { font-size: 24rpx; color: #8D6E63; min-width: 40rpx; }
.completion-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0EBE3;
}
.completion-footer .action-btn { flex: 1; text-align: center; }
.action-secondary { background: #F5F0E8; color: #5D4037; }
